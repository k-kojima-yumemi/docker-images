{
  "name": "hono-otel-template",
  "type": "module",
  "scripts": {
    "format": "biome check --write --unsafe",
    "ci": "biome ci && tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node26 --outfile=dist/index.cjs --external:@opentelemetry/* --external:@hono/standard-validator --external:@standard-community/*",
    "test": "vitest run"
  },
  "volta": {
    "node": "26.13.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/standard-validator": "^0.4.1",
    "@hono/structured-logger": "^1.0.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@valibot/to-json-schema": "^1.8.0",
    "hono": "^4.13.16",
    "hono-openapi": "^1.5.0",
    "valibot": "^1.5.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
