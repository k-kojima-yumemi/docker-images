{
  "name": "postgres-health-check",
  "type": "module",
  "scripts": {
    "format": "biome check --write --unsafe",
    "ci": "biome ci && tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node26 --outfile=dist/index.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "volta": {
    "node": "26.13.1"
  }
}
